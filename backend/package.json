    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "google-auth-library": "^9.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prisma": "^5.0.0",
    "stripe": "^11.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.2.0",
